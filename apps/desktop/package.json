{
  "name": "@courtplus/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Offline CourtPlus desktop application",
  "author": "CourtPlus",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build -w @courtplus/contracts && tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "npm run build && npm run rebuild && electron .",
    "rebuild": "node scripts/rebuild.mjs",
    "dist": "npm run build && npm run rebuild -- --arch=x64 && electron-builder --win --x64 --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.2.0",
    "canonicalize": "2.1.0",
    "onnxruntime-node": "1.31.1",
    "onnxruntime-web": "1.31.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@courtplus/contracts": "0.0.0",
    "@electron/rebuild": "4.2.1",
    "@types/node": "24.10.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
